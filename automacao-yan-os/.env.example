# ============================================================
#  YAN OS — TEMPLATE DE CONFIGURAÇÃO
#  Copie para .env e preencha. NUNCA commitar o .env real.
# ============================================================

# ─── APIs de IA ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
MODELO_CLAUDE=claude-sonnet-4-6

# ─── Servidor HostGator ──────────────────────────────────────
SITE_METHOD=ftp
SITE_HOST=szuchmacher.com.br
SITE_FTP_HOST=ftp.szuchmacher.com.br
SITE_USER=
SITE_PASS=
SITE_REMOTE_DIR=/szuchmacher.com.br/
SITE_URL=https://szuchmacher.com.br

# Publicação por webhook (alternativa ao FTP). Obrigatório se SITE_METHOD=webhook:
# sem ele, _publicar_webhook aborta em vez de assinar com valor previsível.
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SITE_WEBHOOK_URL=
SITE_WEBHOOK_SECRET=

# ─── Notificações WhatsApp / Telegram ───────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# ─── E-mail (distribuição do relatório aos assinantes) ───────
# EMAIL_SENHA: use uma "senha de app" (Gmail) — nunca a senha principal.
# DESTINATARIOS: e-mails separados por vírgula (ex: a@x.com,b@y.com)
EMAIL_REMETENTE=
EMAIL_SENHA=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
DESTINATARIOS=

# ─── Monitor de mercado (thresholds de alerta) ───────────────
THR_IBOV=2.0
THR_DOLAR_NIVEL=5.90
THR_DOLAR_VAR=1.5
THR_SP500=1.5
THR_WTI=5.0
THR_OURO=2.0
THR_TREASURY=10
MONITOR_INTERVALO=15
MONITOR_INICIO=09:00
MONITOR_FIM=18:45

# ─── Qualificador de leads ───────────────────────────────────
LEAD_PORT=8765
# Obrigatório: o servidor de leads não sobe sem ele (recebe dados pessoais).
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEAD_SECRET=

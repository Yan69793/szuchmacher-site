{
  "name": "ui_read",
  "description": "Reads text from a UI element. If UIA text extraction fails, automatically tries OCR.\nExtract text from UI elements or screen regions. Auto-falls back to OCR if normal text extraction fails.\nReturns: The extracted text content from the element or screen region.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "windowHandle": {
        "description": "Window handle as decimal string (from window_management 'find' or 'list'). REQUIRED.",
        "type": "string"
      },
      "name": {
        "description": "Element name (exact match, case-insensitive).",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "nameContains": {
        "description": "Substring in element name (case-insensitive).",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "namePattern": {
        "description": "Regex pattern for element name matching.",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "controlType": {
        "description": "Control type (Text, Edit, Document, etc.)",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "automationId": {
        "description": "AutomationId for precise matching.",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "className": {
        "description": "Element class name.",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "foundIndex": {
        "description": "Return Nth match (1-based, default: 1).",
        "type": "integer",
        "default": 1
      },
      "includeChildren": {
        "description": "Include child element text (default: false).",
        "type": "boolean",
        "default": false
      },
      "language": {
        "description": "OCR language code (e.g., 'en-US', 'de-DE'). Uses system default if not specified. Only used if OCR fallback triggers.",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "includeDiagnostics": {
        "description": "Include diagnostics (timing, query, elements scanned) in response. Default: false.",
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "windowHandle"
    ]
  }
}
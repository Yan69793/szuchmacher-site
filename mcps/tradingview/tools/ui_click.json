{
  "name": "ui_click",
  "description": "Click a UI element by aria-label, data-name, text content, or class substring",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "by": {
        "type": "string",
        "enum": [
          "aria-label",
          "data-name",
          "text",
          "class-contains"
        ],
        "description": "Selector strategy"
      },
      "value": {
        "type": "string",
        "description": "Value to match against the chosen selector strategy"
      }
    },
    "required": [
      "by",
      "value"
    ]
  }
}
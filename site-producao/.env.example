# ============================================================
#  site-producao — credenciais de DEPLOY (FTP HostGator)
#  Copie para .env e preencha. NUNCA commitar o .env real.
# ============================================================
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=

# Plataforma MultiAsset — multi-assets.com (addon domain HostGator)
# Se vazio, deploy-multiasset.ps1 reutiliza FTP_HOST/USER/PASS
FTP_MULTIasset_HOST=
FTP_MULTIasset_USER=
FTP_MULTIasset_PASS=
# Obrigatorio — docroot do addon domain (NUNCA /)
FTP_MULTIasset_REMOTE_DIR=/multi-assets.com/

# Opcional — rode .\scripts\sync-sz-config.ps1 após preencher:
# SZ_CLARITY_ID=xxxxxxxxxx
# Stripe — rode .\scripts\setup-stripe.ps1 após preencher a secret key (teste ou live)
# STRIPE_SECRET_KEY=sk_test_...
# SZ_STRIPE_CARTA_URL=https://buy.stripe.com/...
# SZ_STRIPE_PRO_URL=https://buy.stripe.com/...
# Cloudflare — purge após deploy (.\scripts\purge-cloudflare.ps1 -Diagnose para testar)
# Token: permissão Zone > Cache Purge > Purge, recurso szuchmacher.com.br
# CLOUDFLARE_API_TOKEN=          # deploy/wrangler (pode nao ter Cache Purge)
# CLOUDFLARE_PURGE_TOKEN=        # opcional: token só Zone > Cache Purge > Purge
# DNS multi-assets.com (Zone > DNS Edit + Zone Settings Edit) — setup-multi-assets-dns.ps1 -Apply
# CLOUDFLARE_DNS_TOKEN=
# CLOUDFLARE_ZONE_NAME=szuchmacher.com.br
# CLOUDFLARE_ZONE_ID=cfe602627bd2ef210d225ee9deeb45d9

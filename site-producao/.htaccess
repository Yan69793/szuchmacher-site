

# ========================================================================
# SECURITY HEADERS, MultiAsset Pro, Szuchmacher Consultoria
# Anexar ao final do .htaccess existente em /public_html
# Data, 2026-04-14
# ========================================================================

<IfModule mod_headers.c>

    # HSTS, força HTTPS por 1 ano, inclui subdomínios
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Impede que a página seja renderizada dentro de iframes de terceiros
    Header always set X-Frame-Options "SAMEORIGIN"

    # Impede MIME sniffing do navegador
    Header always set X-Content-Type-Options "nosniff"

    # Limita o envio do Referer a requests same-origin e cross-origin seguros
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restringe APIs do navegador que a plataforma nao usa
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

    # Content Security Policy, ajustada para os providers reais do MultiAsset
    # script-src inclui GA4, TradingView, inline (necessario pois ha JS inline no HTML)
    # connect-src cobre AwesomeAPI, BCB, BrapiDev, BrasilAPI, Formspree (envio dos forms)
    # frame-src cobre TradingView widgets
    # img-src permite data URIs (favicons, placeholders) e HTTPS geral
    # ALTERADO 2026-06-01: +https://formspree.io em connect-src e form-action.
    #   Motivo: forms (leadForm/contactForm) enviam via fetch() ao Formspree e o CSP
    #   antigo (herdado do design subscribe.php same-origin) bloqueava a conexao,
    #   quebrando o botao "Assinar gratis". Evidencia: console "violates connect-src".
    # ALTERADO 2026-06-17: +clarity.ms (script/connect) para Microsoft Clarity quando SZ_CLARITY_ID ativo
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.clarity.ms https://scripts.clarity.ms https://s3.tradingview.com https://s.tradingview.com https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; connect-src 'self' https://szuchmacher.com.br https://multi-assets.com https://economia.awesomeapi.com.br https://api.bcb.gov.br https://brapi.dev https://brasilapi.com.br https://api.coingecko.com https://www.clarity.ms https://*.clarity.ms https://c.clarity.ms https://formspree.io https://cloudflareinsights.com; frame-src https://s.tradingview.com https://www.tradingview.com https://tradingview-widget.com https://www.tradingview-widget.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://szuchmacher.com.br https://multi-assets.com https://formspree.io; object-src 'none'; upgrade-insecure-requests"

    # Esconde assinatura do servidor
    Header unset Server
    Header unset X-Powered-By

</IfModule>

# Protege arquivos sensiveis contra acesso direto
<FilesMatch "^\.(htaccess|htpasswd|env|git)">
    Require all denied
</FilesMatch>

# MultiAsset migrou para dominio proprio (2026-06-17)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^multiasset-app\.html$ https://multi-assets.com/ [R=301,L]
    RewriteRule ^multiasset\.html$ https://multi-assets.com/ [R=301,L]
</IfModule>

# Evita listagem de diretorios
Options -Indexes

# Compressao GZIP para assets estaticos
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# HTML e sz-config mudam no deploy — origem pede revalidacao (Cloudflare obedece sem purge manual)
<FilesMatch "\.(html?)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</FilesMatch>

<Files "sz-config.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</Files>

# Cache de longa duracao para assets imutaveis
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 day"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
